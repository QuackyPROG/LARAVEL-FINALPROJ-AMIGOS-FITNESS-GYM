APP_NAME="Amigos Fitness Gym"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------
# Database — Supabase PostgreSQL
# -----------------------------------------------------------------------
DB_CONNECTION=pgsql
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DB_HOST=db.[ref].supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# -----------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------
SUPABASE_STORAGE_URL=https://[ref].supabase.co/storage/v1
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------
# PayMongo
# Get test keys from: https://dashboard.paymongo.com/developers
# Test card: 4343434343434345, any future expiry, any CVV
# -----------------------------------------------------------------------
PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------
# Anthropic API
# Used for AI features in the Laravel app (claude-sonnet-4-6)
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# -----------------------------------------------------------------------
# Laravel Reverb (WebSocket server — required for live chat)
# -----------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@amigosfitness.ph"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
